[
  {
    "name": "test-roll",
    "user": "staff_user",
    "viewport": "desktop",
    "path": "/admin/presets",
    "setup": [
      {
        "click": ".preset-list__menu >> nth=0"
      },
      {
        "click": ".q-menu .q-item:has-text(\"Test roll\")"
      },
      {
        "waitFor": "text=The randomizer rolled a seed."
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0,
    "annotate": [
      {
        "selector": ".q-dialog .q-card a[href*='seedgen']",
        "n": 1,
        "tab": "bottom"
      }
    ]
  }
]
