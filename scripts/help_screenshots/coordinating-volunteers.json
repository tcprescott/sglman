  {
    "name": "assign-picker-desktop",
    "user": "vc_user",
    "viewport": "desktop",
    "path": "/admin/vol-schedule",
    "setup": [
      {
        "click": "button:has-text('Assign') >> nth=4"
      },
      {
        "waitFor": ".q-dialog .q-card"
      },
      {
        "click": "text=Show unqualified volunteers"
      },
      {
        "wait": 500
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0,
    "annotate": [
      {
        "selector": ".q-dialog .q-checkbox:has-text('Show unqualified volunteers')",
        "n": 1
      },
      {
        "selector": ".q-dialog .q-card :is(.q-badge,.wiz-chip,span):text-is('Qualified')",
        "n": 2
      }
    ]
  },
  {
    "name": "autofill-dialog-desktop",
    "user": "vc_user",
    "viewport": "desktop",
    "path": "/admin/vol-schedule",
    "setup": [
      {
        "click": "button:has-text('Actions')"
      },
      {
        "click": ".q-menu .q-item:has-text('Auto-fill from availability')"
      },
      {
        "waitFor": ".q-dialog .q-card"
      },
      {
        "wait": 500
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0
