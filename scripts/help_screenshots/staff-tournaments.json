[
  {
    "name": "signup-window",
    "user": "staff_user",
    "viewport": "desktop",
    "path": "/admin/tournaments",
    "setup": [
      {
        "click": "text=Add Tournament"
      },
      {
        "waitFor": ".q-dialog"
      },
      {
        "click": ".q-dialog >> text=Scheduling"
      },
      {
        "wait": 600
      },
      {
        "click": ".q-dialog >> text=Tournament Days"
      },
      {
        "wait": 400
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0,
    "annotate": [
      {
        "selector": ".q-dialog .q-field:has-text('Signups open')",
        "n": 1
      },
      {
        "selector": ".q-dialog .q-field:has-text('Signups close')",
        "n": 2
      }
    ]
  }
]
