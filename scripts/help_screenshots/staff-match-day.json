[
  {
    "name": "queues-desktop",
    "user": "staff_user",
    "path": "/admin/schedule",
    "viewport": "desktop",
    "setup": [
      {
        "waitFor": ".match-inbox__item"
      },
      {
        "wait": 800
      }
    ],
    "selector": ".match-inbox",
    "annotate": [
      {
        "selector": ".match-inbox__item button:has-text('Approve')",
        "n": 1
      },
      {
        "selector": ".match-inbox__item:has-text('Flagged') >> text=Flagged",
        "n": 2
      },
      {
        "selector": ".match-inbox__item button:has-text('Confirm')",
        "n": 3
      }
    ]
  },
  {
    "name": "reschedule-request",
    "user": "staff_user",
    "path": "/admin/schedule",
    "viewport": "desktop",
    "setup": [
      {
        "waitFor": ".match-inbox__item"
      },
      {
        "click": ".match-inbox__item button:has-text(\"Decline\")"
      },
      {
        "waitFor": ".q-dialog .q-card"
      },
      {
        "wait": 800
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0,
    "annotate": [
      {
        "selector": ".q-dialog .q-card .q-field:has-text('Note to the player')",
        "n": 1
      },
      {
        "selector": ".q-dialog .q-card button:has-text('Decline')",
        "n": 2
      },
      {
        "selector": ".q-dialog .q-card button:has-text('Approve and move it')",
        "n": 3
      }
    ]
  }
]
