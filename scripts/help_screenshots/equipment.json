[
  {
    "name": "yours-phone",
    "user": "player_one",
    "path": "/home/my-schedule",
    "selector": ".wiz-panel:has-text(\"Equipment you have out\")",
    "annotate": [
      {
        "selector": ".wiz-panel:has-text(\"Equipment you have out\") button:has-text('View')",
        "n": 1
      }
    ]
  },
  {
    "name": "held-phone",
    "user": "player_one",
    "path": "/home/my-schedule",
    "setup": [
      {
        "click": ".wiz-panel:has-text(\"Equipment you have out\") >> text=View"
      },
      {
        "waitFor": "text=Loan history"
      }
    ],
    "selector": ".q-card.page-container-narrow"
  },
  {
    "name": "desk-desktop",
    "user": "equip_manager",
    "path": "/admin/equipment",
    "viewport": "desktop",
    "selector": ".equipment-table",
    "annotate": [
      {
        "selector": ".equipment-table .equipment-state-btn:has-text('Check in') >> nth=0",
        "n": 1
      },
      {
        "selector": ".equipment-table .equipment-state-btn:has-text('Check out') >> nth=0",
        "n": 2
      },
      {
        "selector": ".equipment-table tbody tr >> nth=0 >> button[aria-label^='More']",
        "n": 3
      }
    ]
  },
  {
    "name": "checkout-desktop",
    "user": "equip_manager",
    "path": "/admin/equipment",
    "viewport": "desktop",
    "setup": [
      {
        "click": ".equipment-table .equipment-state-btn >> text=Check out"
      },
      {
        "waitFor": ".q-dialog .q-card"
      }
    ],
    "selector": ".q-dialog .q-card",
    "padding": 0,
    "annotate": [
      {
        "selector": ".q-dialog .q-select",
        "n": 1,
        "tab": "bottom"
      },
      {
        "selector": ".q-dialog .q-checkbox:has-text('Include people outside this community')",
        "n": 2
      }
    ]
  }
]
